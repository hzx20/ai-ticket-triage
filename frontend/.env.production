# 环境变量 (命名必须以 VITE_ 开头)
# 部署目标：134.175.137.18（腾讯云轻量 广州）

# 是否在打包时启用 Mock
VITE_BUILD_MOCK = false

# 接口前缀：src/utils/http.ts 里 baseURL 取 `VITE_API_PREFIX ?? VITE_API_BASE_URL`，
# 这里设成 /api，所有接口变成同源相对路径，由 nginx 反代到后端容器。
# 好处：浏览器不触发跨域，也不用把公网 IP 写死进产物。
VITE_API_PREFIX = '/api'

# 接口地址（留空，实际以 VITE_API_PREFIX 为准）
VITE_API_BASE_URL = ''

# WebSocket 地址：必须绝对地址，先不上 HTTPS 所以用 ws://
VITE_API_WS_URL = 'ws://134.175.137.18'

# 地址前缀
VITE_BASE = '/'

# 应用配置面板
VITE_APP_SETTING = true

# 客户端ID
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'
